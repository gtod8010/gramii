# .env.local 파일로 복사 후 실제 값으로 수정하세요
# cp .env.example .env.local

# --- 공통 설정 ---
APP_ENV="development"
JWT_SECRET="your-jwt-secret-key-here"

# --- 데이터베이스 설정 ---
# gramii 서비스 전용 DB
POSTGRES_URL_GRAMII="postgresql://gramii_user:password@localhost:5432/gramii_db"
# orda 서비스 전용 DB
POSTGRES_URL_ORDA="postgresql://orda_user:password@localhost:5432/orda_db"

# --- RealSite API 설정 ---
REALSITE_API_KEY_GRAMII="your-realsite-gramii-key"
REALSITE_API_KEY_ORDA="your-realsite-orda-key"
REALSITE_API_URL="https://realsite.shop/api/v2"

# --- 2PM API 설정 (그래미 전용) ---
TWOPM_API_KEY="your-2pm-api-key"
TWOPM_API_URL="https://2pm.co.kr/api/v2"

# --- InstaMonster API 설정 ---
INSTAMONSTER_API_KEY_GRAMII="your-instamonster-gramii-key"
INSTAMONSTER_API_KEY_ORDA="your-instamonster-orda-key"
INSTAMONSTER_API_URL="https://instamonster.co.kr/api/v2"
